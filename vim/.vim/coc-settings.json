{
	"suggest.timeout": 500,
	"signature.target": "echo",
	"signature.triggerSignatureWait": 200,
	"diagnostic.messageDelay": 100,
	"diagnostic.refreshOnInsertMode": false,
	"diagnostic.virtualText": true,
	"diagnostic.virtualTextCurrentLineOnly": true,
	"suggest.minTriggerInputLength": 2,
	"suggest.maxCompleteItemCount": 50,
	"coc.preferences.formatOnSave": true,
	"list.floatPreview": true,
	"suggest.autoTrigger": "always",
	"inlayHint.enable": false,
	"semanticTokens.enable": true,
	"rust-analyzer.check.command": "clippy",
	"rust-analyzer.checkOnSave": true,
	"rust-analyzer.check.workspace": true,
	"rust-analyzer.diagnostics.enable": true,
	"rust-analyzer.diagnostics.experimental.enable": true,
	"rust-analyzer.procMacro.enable": true,
	"workspace.ignoredFolders": [
		"$HOME",
		"$HOME/.cargo/**",
		"$HOME/.rustup/**"
	],
	"extensions.updateCheck": "daily",
	"languageserver": {
		"nextflow": {
			"command": "java",
			"args": [
				"-jar",
				"/Users/eli/clones/nf-language-server/build/libs/language-server-all.jar"
			],
			"filetypes": [
				"nextflow"
			],
			"rootPatterns": [
				"nextflow.config",
				".git/"
			],
			"settings": {
				"formatCommand": "nextflow lint -format",
				"nextflow": {
					"files": {
						"exclude": [
							".git",
							".nf-test",
							"work"
						]
					}
				}
			}
		},
		"tinymist": {
			"command": "tinymist",
			"args": [
				"lsp"
			],
			"filetypes": [
				"typst"
			],
			"rootPatterns": [
				"*.typ",
				"main.typ",
				".git/"
			]
		},
		"zls": {
			"command": "zls",
			"filetypes": [
				"zig"
			],
			"rootPatterns": [
				"*.zig",
				"build.zig"
			]
		},
		"glslint": {
			"command": "glslint",
			"args": [
				"lsp"
			],
			"filetypes": [
				"glsl",
				"vert",
				"frag",
				"geom",
				"comp",
				"tesc",
				"tese"
			],
			"rootPatterns": [
				".git",
				"compile_commands.json"
			]
		}
  },
  "json.schemaDownload.trustedDomains": {
    "https://opencode.ai": true,
    "https://models.dev": true
  }
}
